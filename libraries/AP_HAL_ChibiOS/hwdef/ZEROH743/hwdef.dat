# hw definition file for processing by chibios_pins.py
# for Diatone ZEROH743 hardware.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID for firmware load
APJ_BOARD_ID AP_HW_MAMBAH743_V4

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

MCU_CLOCKRATE_MHZ 480

FLASH_SIZE_KB 2048

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# leave 1 sectors free
FLASH_RESERVE_START_KB 384
env OPTIMIZE -O2

# use 2 pages for flash storage
# H743 has 16 pages of 128k each
STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 32768

# one I2C bus
I2C_ORDER I2C1 I2C2

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 USART6 UART7 UART8

# buzzer
PE3 BUZZER OUTPUT LOW PULLDOWN GPIO(80)
define HAL_BUZZER_PIN 80

# PA10 IO-debug-console
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PE6  VBUS INPUT OPENDRAIN

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 for IMU1 (ICM42688)
PA4 IMU1_CS CS
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

# SPI2 for MAX7456 OSD
PB12 MAX7456_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

# SPI3 for flash
PA15 FLASH_CS CS
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PB2  SPI3_MOSI SPI3

# SPI4 for IMU2 (ICM42688)
PE11 IMU2_CS CS
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4

# I2C1 for onboard BMP390 baro and external compass (enable internal pullup as schematic has no external pullups)
PB6 I2C1_SCL I2C1 PULLUP
PB7 I2C1_SDA I2C1 PULLUP

# I2C2 (enable internal pullup)
PB10 I2C2_SCL I2C2 PULLUP
PB11 I2C2_SDA I2C2 PULLUP

PC1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC3 BATT_CURRENT_SENS ADC1 SCALE(1)

# define default battery setup (schematic divider: 10k / 1k -> scale 11.0)
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 11
define HAL_BATT_CURR_PIN 13
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 64

PC2 RSSI_ADC ADC1
define BOARD_RSSI_ANA_PIN 12

# Schematic LED2 (PE4=LED0) & LED3 (PE5=LED1) have cathodes to GND -> Active HIGH
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PE4 LED0 OUTPUT HIGH GPIO(90)
PE5 LED1 OUTPUT HIGH GPIO(91)
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91
define HAL_GPIO_LED_ON 1

# USART1 (RX / SBUS)
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# USART2 (GPS connector on schematic has TX2/RX2 + I2C1)
PD5 USART2_TX USART2
PD6 USART2_RX USART2
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS

# USART3 (VTX)
PD8 USART3_TX USART3 NODMA
PD9 USART3_RX USART3 NODMA

# UART4
PD1 UART4_TX UART4 NODMA
PD0 UART4_RX UART4 NODMA

# UART5 (SPORT)
PC12 UART5_TX UART5 NODMA
PD2  UART5_RX UART5 NODMA

# USART6 (ESC Telemetry)
PC6 USART6_TX USART6 NODMA
PC7 USART6_RX USART6 NODMA

# UART7 (GPS)
PE8 UART7_TX UART7
PE7 UART7_RX UART7

PE1 UART8_TX UART8 NODMA
PE0 UART8_RX UART8 NODMA

define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_RCIN
define DEFAULT_SERIAL1_BAUD 115
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_ESCTelemetry
define DEFAULT_SERIAL6_BAUD 115

# Motors
PA0  TIM5_CH1 TIM5 PWM(1) GPIO(50) BIDIR
PA1  TIM5_CH2 TIM5 PWM(2) GPIO(51)
PA2  TIM5_CH3 TIM5 PWM(3) GPIO(52) BIDIR
PA3  TIM5_CH4 TIM5 PWM(4) GPIO(53)
PB0  TIM3_CH3 TIM3 PWM(5) GPIO(54) BIDIR
PB1  TIM3_CH4 TIM3 PWM(6) GPIO(55)
PC8  TIM8_CH3 TIM8 PWM(7) GPIO(56) BIDIR
PC9  TIM8_CH4 TIM8 PWM(8) GPIO(57)

# VTX Power control - should be high at startup to ensure power
PC5 VTX_PWR OUTPUT HIGH GPIO(81)
define RELAY2_PIN_DEFAULT 81

# Motor order implies Betaflight/X for standard ESCs
define HAL_FRAME_TYPE_DEFAULT 12

# LED strip
PA8 TIM1_CH1 TIM1 PWM(9) GPIO(58)

DMA_NOSHARE SPI3* SPI1*

# spi devices
SPIDEV icm42688   SPI1 DEVID1 IMU1_CS      MODE3   2*MHZ  16*MHZ
SPIDEV icm42688_2 SPI4 DEVID4 IMU2_CS      MODE3   2*MHZ  16*MHZ
SPIDEV dataflash  SPI3 DEVID1 FLASH_CS     MODE3 104*MHZ 104*MHZ
SPIDEV osd        SPI2 DEVID4 MAX7456_CS   MODE0  10*MHZ  10*MHZ

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
define HAL_DEFAULT_INS_FAST_SAMPLE 3

# two IMUs (dual ICM42688)
IMU Invensensev3 SPI:icm42688 ROTATION_YAW_90
IMU Invensensev3 SPI:icm42688_2 ROTATION_NONE

DATAFLASH littlefs:w25nxx

# BARO (BMP388 driver supports both BMP388 and BMP390)
BARO BMP388 I2C:0:0x76
BARO BMP388 I2C:0:0x77

# setup for OSD
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

define DEFAULT_NTF_LED_TYPES 257
